{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Service API",
    "description": "MediaAgent ReNews AI Content Creation Service",
    "version": "1.0.0"
  },
  "servers": [],
  "paths": {
    "/api/v1/ai/scope-agent/execute": {
      "post": {
        "tags": ["Scope Agent"],
        "summary": "Execute Scope Agent",
        "description": "Execute a scope agent with user and project constraints.\n\nEnsures only one scope agent runs per user per project at a time.",
        "operationId": "execute_scope_agent_api_v1_ai_scope_agent_execute_post",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScopeAgentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScopeAgentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/scope-agent/status/{task_id}": {
      "get": {
        "tags": ["Scope Agent"],
        "summary": "Get Scope Agent Status",
        "description": "Get the status of a scope agent task.",
        "operationId": "get_scope_agent_status_api_v1_ai_scope_agent_status__task_id__get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScopeAgentStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/scope-agent/tasks": {
      "get": {
        "tags": ["Scope Agent"],
        "summary": "List Scope Agent Tasks",
        "description": "List scope agent tasks for a user, optionally filtered by project.",
        "operationId": "list_scope_agent_tasks_api_v1_ai_scope_agent_tasks_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Project Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScopeAgentListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/scope-agent/cancel/{task_id}": {
      "post": {
        "tags": ["Scope Agent"],
        "summary": "Cancel Scope Agent Task",
        "description": "Cancel a running scope agent task.",
        "operationId": "cancel_scope_agent_task_api_v1_ai_scope_agent_cancel__task_id__post",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/scope-agent/state/{task_id}": {
      "get": {
        "tags": ["Scope Agent"],
        "summary": "Get Scope Agent Graph State",
        "description": "Get the LangGraph state for a running scope agent task.\n\nThis returns the internal state of the LangGraph including messages,\nnext nodes to execute, and other graph state information.",
        "operationId": "get_scope_agent_graph_state_api_v1_ai_scope_agent_state__task_id__get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Scope Agent",
      "description": "Scope Agent 相关的 API"
    }
  ],
  "components": {
    "schemas": {
      "ScopeAgentRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Query",
            "description": "Query or input for the scope agent"
          }
        },
        "type": "object",
        "required": ["query"],
        "title": "ScopeAgentRequest",
        "description": "Request model for scope agent execution."
      },
      "ScopeAgentListResponse": {
        "properties": {
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/ScopeAgentStatusResponse"
            },
            "type": "array",
            "title": "Tasks",
            "description": "List of agent tasks"
          },
          "total_count": {
            "type": "integer",
            "title": "Total Count",
            "description": "Total number of tasks"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User ID"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id",
            "description": "Project ID if filtered by project"
          }
        },
        "type": "object",
        "required": ["tasks", "total_count", "user_id"],
        "title": "ScopeAgentListResponse",
        "description": "Response model for listing scope agent tasks."
      },
      "ScopeAgentStatusResponse": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "Task ID"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current status of the agent"
          },
          "progress": {
            "type": "integer",
            "title": "Progress",
            "description": "Progress percentage (0-100)"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result",
            "description": "Result data if the agent completed successfully"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Error message if the agent failed"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User ID associated with the task"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id",
            "description": "Project ID associated with the task"
          },
          "agent_type": {
            "type": "string",
            "title": "Agent Type",
            "description": "Type of agent"
          },
          "created_at": {
            "type": "number",
            "title": "Created At",
            "description": "Timestamp when the task was created"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At",
            "description": "Timestamp when the task was last updated"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "status",
          "progress",
          "user_id",
          "project_id",
          "agent_type",
          "created_at",
          "updated_at"
        ],
        "title": "ScopeAgentStatusResponse",
        "description": "Response model for scope agent status."
      },
      "ScopeAgentResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "Whether the agent execution was started successfully"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "Unique task ID for tracking the agent execution"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Status message"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User ID associated with the task"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id",
            "description": "Project ID associated with the task"
          },
          "agent_type": {
            "type": "string",
            "title": "Agent Type",
            "description": "Type of agent that was executed"
          }
        },
        "type": "object",
        "required": ["success", "task_id", "message", "user_id", "project_id", "agent_type"],
        "title": "ScopeAgentResponse",
        "description": "Response model for scope agent execution."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      }
    }
  }
}
