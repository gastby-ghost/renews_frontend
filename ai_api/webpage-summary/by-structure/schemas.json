{
  "WebpageSummaryStatusResponse": {
    "properties": {
      "success": {
        "type": "boolean",
        "title": "Success",
        "description": "是否成功"
      },
      "task_id": {
        "type": "string",
        "title": "Task Id",
        "description": "任务ID"
      },
      "status": {
        "type": "string",
        "title": "Status",
        "description": "任务状态"
      },
      "progress": {
        "type": "integer",
        "title": "Progress",
        "description": "进度百分比"
      },
      "result": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "title": "Result",
        "description": "任务结果"
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Error",
        "description": "错误信息"
      }
    },
    "type": "object",
    "required": ["success", "task_id", "status", "progress"],
    "title": "WebpageSummaryStatusResponse",
    "description": "网页总结任务状态响应"
  },
  "WebpageSummaryAsyncRequest": {
    "properties": {
      "url": {
        "type": "string",
        "minLength": 1,
        "title": "Url",
        "description": "要总结的网页URL"
      },
      "model_name": {
        "type": "string",
        "title": "Model Name",
        "description": "使用的模型名称",
        "default": "deepseek:deepseek-chat"
      },
      "max_tokens": {
        "type": "integer",
        "maximum": 10000.0,
        "minimum": 100.0,
        "title": "Max Tokens",
        "description": "模型最大token数",
        "default": 8192
      },
      "scraping_timeout": {
        "type": "integer",
        "maximum": 300.0,
        "minimum": 5.0,
        "title": "Scraping Timeout",
        "description": "网页抓取超时时间（秒）",
        "default": 120
      },
      "max_content_length": {
        "type": "integer",
        "maximum": 100000.0,
        "minimum": 1000.0,
        "title": "Max Content Length",
        "description": "最大内容长度限制",
        "default": 128000
      },
      "target_format": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "title": "Target Format",
        "description": "目标JSON格式（可选）",
        "example": {
          "key_excerpts": ["摘录原文1", "摘录原文2", "摘录原文3"],
          "summary": "文章摘要"
        }
      }
    },
    "type": "object",
    "required": ["url"],
    "title": "WebpageSummaryAsyncRequest",
    "description": "异步网页总结请求"
  },
  "WebpageSummaryAsyncResponse": {
    "properties": {
      "success": {
        "type": "boolean",
        "title": "Success",
        "description": "是否成功"
      },
      "message": {
        "type": "string",
        "title": "Message",
        "description": "响应消息"
      },
      "task_id": {
        "type": "string",
        "title": "Task Id",
        "description": "任务ID"
      },
      "url": {
        "type": "string",
        "title": "Url",
        "description": "请求的URL"
      }
    },
    "type": "object",
    "required": ["success", "message", "task_id", "url"],
    "title": "WebpageSummaryAsyncResponse",
    "description": "异步网页总结响应"
  },
  "HTTPValidationError": {
    "properties": {
      "detail": {
        "items": {
          "$ref": "#/components/schemas/ValidationError"
        },
        "type": "array",
        "title": "Detail"
      }
    },
    "type": "object",
    "title": "HTTPValidationError"
  }
}
