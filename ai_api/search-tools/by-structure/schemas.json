{
  "SearchToolsResponse": {
    "properties": {
      "success": {
        "type": "boolean",
        "title": "Success",
        "description": "Whether the search was successful"
      },
      "provider": {
        "type": "string",
        "title": "Provider",
        "description": "Search provider used (tavily/bocha)"
      },
      "results": {
        "items": {
          "$ref": "#/components/schemas/SearchResultItem"
        },
        "type": "array",
        "title": "Results",
        "description": "搜索结果列表"
      },
      "total_results": {
        "type": "integer",
        "title": "Total Results",
        "description": "总结果数量"
      },
      "search_queries": {
        "items": {
          "type": "string"
        },
        "type": "array",
        "title": "Search Queries",
        "description": "执行的搜索查询列表"
      },
      "search_time": {
        "type": "number",
        "title": "Search Time",
        "description": "搜索耗时（秒）"
      },
      "api_execution_time": {
        "type": "number",
        "title": "Api Execution Time",
        "description": "API执行时间（秒）"
      },
      "query_count": {
        "type": "integer",
        "title": "Query Count",
        "description": "Number of queries executed"
      }
    },
    "type": "object",
    "required": [
      "success",
      "provider",
      "results",
      "total_results",
      "search_queries",
      "search_time",
      "api_execution_time",
      "query_count"
    ],
    "title": "SearchToolsResponse",
    "description": "Response model for search tools."
  },
  "UnifiedSearchRequest": {
    "properties": {
      "queries": {
        "items": {
          "type": "string"
        },
        "type": "array",
        "minItems": 1,
        "title": "Queries",
        "description": "List of search queries"
      },
      "max_results": {
        "type": "integer",
        "maximum": 50.0,
        "minimum": 1.0,
        "title": "Max Results",
        "description": "Maximum number of results",
        "default": 10
      },
      "enable_structured_summaries": {
        "type": "boolean",
        "title": "Enable Structured Summaries",
        "description": "Enable AI-generated summaries for search results",
        "default": true
      },
      "summarization_model": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Summarization Model",
        "description": "Model to use for summarization",
        "default": "deepseek:deepseek-chat"
      },
      "max_content_length": {
        "type": "integer",
        "maximum": 200000.0,
        "minimum": 1000.0,
        "title": "Max Content Length",
        "description": "Maximum content length for summarization",
        "default": 50000
      },
      "topic": {
        "anyOf": [
          {
            "type": "string",
            "enum": ["general", "news", "finance"]
          },
          {
            "type": "null"
          }
        ],
        "title": "Topic",
        "description": "Search topic filter (Tavily only)",
        "default": "general"
      },
      "include_raw_content": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "title": "Include Raw Content",
        "description": "Include full webpage content (Tavily only)",
        "default": true
      },
      "freshness": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Freshness",
        "description": "Time range filter (Bocha only)"
      },
      "summary": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "title": "Summary",
        "description": "Return AI-generated summaries (Bocha only)",
        "default": true
      },
      "include": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Include",
        "description": "Include only these domains (Bocha only)"
      },
      "exclude": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Exclude",
        "description": "Exclude these domains (Bocha only)"
      },
      "provider": {
        "type": "string",
        "enum": ["tavily", "bocha"],
        "title": "Provider",
        "description": "Search provider to use"
      }
    },
    "type": "object",
    "required": ["queries", "provider"],
    "title": "UnifiedSearchRequest",
    "description": "Unified request model for all search providers."
  },
  "SearchToolsStatusResponse": {
    "properties": {
      "tavily_configured": {
        "type": "boolean",
        "title": "Tavily Configured",
        "description": "Whether Tavily API is configured"
      },
      "bocha_configured": {
        "type": "boolean",
        "title": "Bocha Configured",
        "description": "Whether Bocha API is configured"
      },
      "tavily_api_key_status": {
        "type": "string",
        "title": "Tavily Api Key Status",
        "description": "Tavily API key status"
      },
      "bocha_api_key_status": {
        "type": "string",
        "title": "Bocha Api Key Status",
        "description": "Bocha API key status"
      },
      "default_provider": {
        "type": "string",
        "title": "Default Provider",
        "description": "Default search provider"
      },
      "available_providers": {
        "items": {
          "type": "string"
        },
        "type": "array",
        "title": "Available Providers",
        "description": "List of available providers"
      }
    },
    "type": "object",
    "required": [
      "tavily_configured",
      "bocha_configured",
      "tavily_api_key_status",
      "bocha_api_key_status",
      "default_provider",
      "available_providers"
    ],
    "title": "SearchToolsStatusResponse",
    "description": "Response model for search tools status."
  },
  "HTTPValidationError": {
    "properties": {
      "detail": {
        "items": {
          "$ref": "#/components/schemas/ValidationError"
        },
        "type": "array",
        "title": "Detail"
      }
    },
    "type": "object",
    "title": "HTTPValidationError"
  }
}
