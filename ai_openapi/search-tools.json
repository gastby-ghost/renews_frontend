  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SearchToolsExecuteRequest": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["tavily", "bocha"],
            "title": "Provider",
            "description": "Search provider to use"
          },
          "queries": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Queries",
            "description": "List of search queries"
          },
          "max_results": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Results",
            "description": "Maximum number of results",
            "default": 10
          },
          "enable_structured_summaries": {
            "type": "boolean",
            "title": "Enable Structured Summaries",
            "description": "Enable AI-generated summaries for search results",
            "default": true
          },
          "summarization_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summarization Model",
            "description": "Model to use for summarization",
            "default": "deepseek:deepseek-chat"
          },
          "max_content_length": {
            "type": "integer",
            "maximum": 200000.0,
            "minimum": 1000.0,
            "title": "Max Content Length",
            "description": "Maximum content length for summarization",
            "default": 8192
          },
          "topic": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["general", "news", "finance"]
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic",
            "description": "Search topic filter (Tavily only)",
            "default": "general"
          },
          "include_raw_content": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Include Raw Content",
            "description": "Include full webpage content (Tavily only)",
            "default": true
          },
          "freshness": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Freshness",
            "description": "Time range filter (Bocha only)"
          },
          "summary": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary",
            "description": "Return AI-generated summaries (Bocha only)",
            "default": true
          },
          "include": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Include",
            "description": "Include only these domains (Bocha only)"
          },
          "exclude": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exclude",
            "description": "Exclude these domains (Bocha only)"
          }
        },
        "type": "object",
        "required": ["provider", "queries"],
        "title": "SearchToolsExecuteRequest",
        "description": "Request model for executing search tools with async status mode."
      },
      "SearchToolsExecuteResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "Whether the search execution was started successfully"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "Unique task ID for tracking the search execution"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Status message"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User ID associated with the task"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id",
            "description": "Project ID associated with the task"
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "description": "Search provider that will be used"
          },
          "query_preview": {
            "type": "string",
            "title": "Query Preview",
            "description": "Preview of search queries"
          },
          "is_default_project": {
            "type": "boolean",
            "title": "Is Default Project",
            "description": "Whether the task uses default project ID",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "success",
          "task_id",
          "message",
          "user_id",
          "project_id",
          "provider",
          "query_preview"
        ],
        "title": "SearchToolsExecuteResponse",
        "description": "Response model for executing search tools."
      },
