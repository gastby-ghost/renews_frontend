{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Service API - Outline Generate",
    "description": "MediaAgent ReNews AI Content Creation Service - Module: outline-generate",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/ai/document_generate/outline-agent/generate": {
      "post": {
        "tags": ["Document Generate"],
        "summary": "Generate Outline Endpoint",
        "description": "Generate news article outline based on selected title and web search data.\n\nThis endpoint directly exposes the outline generation agent with structured output,\nproviding detailed structure for news article creation.\n\nArgs:\n    request: Outline generation parameters including title and search data\n    \nReturns:\n    Structured outline generation output with metadata and timing information",
        "operationId": "generate_outline_endpoint_api_v1_ai_document_generate_outline_agent_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OutlineGenerationRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OutlineGenerationResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/document_generate/outline-agent/status": {
      "get": {
        "tags": ["Document Generate"],
        "summary": "Get Outline Tools Status",
        "description": "Get the status of outline generation tools.",
        "operationId": "get_outline_tools_status_api_v1_ai_document_generate_outline_agent_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OutlineGenerationStatusResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OutlineGenerationRequest": {
        "properties": {
          "title": {
            "$ref": "#/components/schemas/Title",
            "description": "选定的新闻标题（来自TitleState的完整Title对象）"
          },
          "research_brief": {
            "type": "string",
            "minLength": 10,
            "title": "Research Brief",
            "description": "研究简报"
          },
          "web_search_data": {
            "anyOf": [
              { "items": { "$ref": "#/components/schemas/SearchResultItem" }, "type": "array" },
              { "items": { "type": "string" }, "type": "array" }
            ],
            "minLength": 1,
            "title": "Web Search Data",
            "description": "网络搜索数据"
          },
          "target_audience": {
            "type": "string",
            "title": "Target Audience",
            "description": "目标受众，如：普通公众、行业专业人士、政策制定者、青年群体等",
            "default": "普通公众"
          },
          "news_type": {
            "type": "string",
            "title": "News Type",
            "description": "新闻类型，如：新闻报道、深度特写、调查报道、评论文章、人物专访、数据分析报道等",
            "default": "新闻报道"
          },
          "total_word_count": {
            "type": "string",
            "title": "Total Word Count",
            "description": "总字数范围，如：800-1200字、1500-2000字等",
            "default": "800-1200字"
          },
          "publishing_platform": {
            "type": "string",
            "title": "Publishing Platform",
            "description": "发布平台，如：新闻网站、移动APP、印刷报纸、社交媒体等",
            "default": "新闻网站"
          },
          "writing_style": {
            "type": "string",
            "title": "Writing Style",
            "description": "写作风格，如：客观报道、叙事性、批判性、轻松幽默、专业严谨等",
            "default": "客观报道"
          },
          "multimedia_requirements": {
            "type": "string",
            "title": "Multimedia Requirements",
            "description": "多媒体要求，如：需要配图、数据图表、视频链接、信息图等",
            "default": "需要配图"
          }
        },
        "type": "object",
        "required": ["title", "research_brief", "web_search_data"],
        "title": "OutlineGenerationRequest",
        "description": "Request model for outline generation."
      },
      "OutlineGenerationResponse": {
        "properties": {
          "success": { "type": "boolean", "title": "Success", "description": "是否成功生成大纲" },
          "outline": {
            "items": { "$ref": "#/components/schemas/OutlineSection-Output" },
            "type": "array",
            "title": "Outline",
            "description": "生成的大纲结构"
          },
          "outline_sources_details": {
            "additionalProperties": {
              "items": { "additionalProperties": true, "type": "object" },
              "type": "array"
            },
            "type": "object",
            "title": "Outline Sources Details",
            "description": "大纲来源详细信息映射"
          },
          "generation_time": {
            "type": "number",
            "title": "Generation Time",
            "description": "大纲生成时间（秒）"
          },
          "section_count": {
            "type": "integer",
            "title": "Section Count",
            "description": "大纲章节数量"
          },
          "generation_summary": {
            "type": "string",
            "title": "Generation Summary",
            "description": "大纲生成过程总结",
            "default": ""
          },
          "total_word_estimate": {
            "anyOf": [{ "type": "integer" }, { "type": "null" }],
            "title": "Total Word Estimate",
            "description": "总字数估算"
          },
          "final_report": {
            "type": "string",
            "title": "Final Report",
            "description": "最终报告",
            "default": ""
          }
        },
        "type": "object",
        "required": ["success", "outline", "generation_time", "section_count"],
        "title": "OutlineGenerationResponse",
        "description": "Response model for outline generation."
      },
      "OutlineGenerationStatusResponse": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured",
            "description": "是否已配置大纲生成功能"
          },
          "available_models": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Available Models",
            "description": "可用模型列表"
          },
          "default_model": { "type": "string", "title": "Default Model", "description": "默认模型" }
        },
        "type": "object",
        "required": ["configured", "available_models", "default_model"],
        "title": "OutlineGenerationStatusResponse",
        "description": "Response model for outline generation status."
      },
      "OutlineSection-Output": {
        "properties": {
          "level": {
            "type": "integer",
            "title": "Level",
            "description": "章节层级，1为一级标题，2为二级标题，以此类推"
          },
          "title": { "type": "string", "title": "Title", "description": "章节标题" },
          "content_direction": {
            "type": "string",
            "title": "Content Direction",
            "description": "内容方向和写作要点"
          },
          "data_requirements": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Data Requirements",
            "description": "需要采集的数据类型和来源"
          },
          "estimated_word_count": {
            "anyOf": [{ "type": "integer" }, { "type": "null" }],
            "title": "Estimated Word Count",
            "description": "预计字数"
          },
          "priority": {
            "type": "string",
            "title": "Priority",
            "description": "优先级：high/medium/low",
            "default": "medium"
          },
          "sources": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Sources",
            "description": "支持该章节的来源编号"
          },
          "multimedia_elements": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Multimedia Elements",
            "description": "多媒体元素列表，如配图、图表、视频等"
          },
          "audience_consideration": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Audience Consideration",
            "description": "针对目标受众的特定写作要点"
          },
          "style_guidance": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Style Guidance",
            "description": "保持写作风格的具体技巧"
          }
        },
        "type": "object",
        "required": ["level", "title", "content_direction"],
        "title": "OutlineSection",
        "description": "单个大纲章节的结构化表示"
      },
      "SearchResultItem": {
        "properties": {
          "url": { "type": "string", "title": "Url", "description": "搜索结果URL" },
          "webtitle": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Webtitle",
            "description": "网页标题"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "搜索相关性评分"
          },
          "query": { "type": "string", "title": "Query", "description": "产生此结果的搜索查询" },
          "aititle": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Aititle",
            "description": "AI总结标题"
          },
          "summary": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Summary",
            "description": "AI生成的内容摘要"
          },
          "content": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Content",
            "description": "网页原始内容"
          },
          "tags": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Tags",
            "description": "标签"
          },
          "key_excerpts": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Key Excerpts",
            "description": "关键摘录"
          },
          "published_date": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Published Date",
            "description": "发布日期"
          }
        },
        "type": "object",
        "required": ["url", "score", "query"],
        "title": "SearchResultItem",
        "description": "Individual search result item."
      },
      "Title": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "一个客观、简洁、吸引人的新闻标题"
          },
          "angle": {
            "type": "string",
            "title": "Angle",
            "description": "具体说明报道的核心思路和切入点"
          },
          "why_now": { "type": "string", "title": "Why Now", "description": "新闻时效性钩子" },
          "news_values": {
            "items": { "type": "string" },
            "type": "array",
            "title": "News Values",
            "description": "新闻价值标准列表，包含：Timeliness, Impact, Proximity, Prominence, Conflict, Human Interest, Novelty"
          },
          "verifiability": {
            "type": "string",
            "title": "Verifiability",
            "description": "评估依据现有来源进行核实的难易程度"
          },
          "sources": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Sources",
            "description": "支持该标题的具体来源编号列表，如 ['1', '2']"
          },
          "risk_notes": { "type": "string", "title": "Risk Notes", "description": "任何潜在风险" },
          "feasibility": {
            "type": "string",
            "title": "Feasibility",
            "description": "完成报道的可行性"
          }
        },
        "type": "object",
        "required": [
          "title",
          "angle",
          "why_now",
          "news_values",
          "verifiability",
          "sources",
          "risk_notes",
          "feasibility"
        ],
        "title": "Title",
        "description": "单个新闻标题候选的结构化表示"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
