{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Service API - Search Agent",
    "description": "MediaAgent ReNews AI Content Creation Service - Module: search-agent",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/ai/search-agent/execute": {
      "post": {
        "tags": ["Search Agent"],
        "summary": "Execute Search Agent",
        "description": "Execute a search agent with user and project constraints.\n\nEnsures only one search agent runs per user per project at a time.\nIf project_id is not provided, uses user's default project.",
        "operationId": "execute_search_agent_api_v1_ai_search_agent_execute_post",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "title": "User Id" }
          },
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Project Id" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SearchAgentRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchAgentResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/search-agent/status/{task_id}": {
      "get": {
        "tags": ["Search Agent"],
        "summary": "Get Search Agent Status",
        "description": "Get the status of a search agent task.",
        "operationId": "get_search_agent_status_api_v1_ai_search_agent_status__task_id__get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Task Id" }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "title": "User Id" }
          },
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Project Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchAgentStatusResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/search-agent/tasks": {
      "get": {
        "tags": ["Search Agent"],
        "summary": "List Search Agent Tasks",
        "description": "List search agent tasks for a user.",
        "operationId": "list_search_agent_tasks_api_v1_ai_search_agent_tasks_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "title": "User Id" }
          },
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Project Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchAgentListResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/search-agent/cancel/{task_id}": {
      "post": {
        "tags": ["Search Agent"],
        "summary": "Cancel Search Agent Task",
        "description": "Cancel a running search agent task.",
        "operationId": "cancel_search_agent_task_api_v1_ai_search_agent_cancel__task_id__post",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Task Id" }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "title": "User Id" }
          },
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Project Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": {} } }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/search-agent/state/{task_id}": {
      "get": {
        "tags": ["Search Agent"],
        "summary": "Get Search Agent Graph State",
        "description": "Get the current LangGraph state for a running search agent task.",
        "operationId": "get_search_agent_graph_state_api_v1_ai_search_agent_state__task_id__get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Task Id" }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "title": "User Id" }
          },
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Project Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": {} } }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SearchAgentListResponse": {
        "properties": {
          "tasks": {
            "items": { "$ref": "#/components/schemas/SearchAgentStatusResponse" },
            "type": "array",
            "title": "Tasks",
            "description": "List of agent tasks"
          },
          "total_count": {
            "type": "integer",
            "title": "Total Count",
            "description": "Total number of tasks"
          },
          "user_id": { "type": "string", "title": "User Id", "description": "User ID" },
          "project_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Project Id",
            "description": "Project ID if filtered by project"
          }
        },
        "type": "object",
        "required": ["tasks", "total_count", "user_id"],
        "title": "SearchAgentListResponse",
        "description": "Response model for listing search agent tasks."
      },
      "SearchAgentRequest": {
        "properties": {
          "brief": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Brief",
            "description": "brief for research"
          },
          "max_concurrent_research_units": {
            "anyOf": [{ "type": "integer" }, { "type": "null" }],
            "title": "Max Concurrent Research Units",
            "description": "Maximum number of concurrent research units (overrides default config)"
          },
          "max_researcher_iterations": {
            "anyOf": [{ "type": "integer" }, { "type": "null" }],
            "title": "Max Researcher Iterations",
            "description": "Maximum number of research iterations (overrides default config)"
          }
        },
        "type": "object",
        "required": ["brief"],
        "title": "SearchAgentRequest",
        "description": "Request model for search agent execution."
      },
      "SearchAgentResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "Whether the agent execution was started successfully"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "Unique task ID for tracking the agent execution"
          },
          "message": { "type": "string", "title": "Message", "description": "Status message" },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User ID associated with the task"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id",
            "description": "Project ID associated with the task"
          },
          "agent_type": {
            "type": "string",
            "title": "Agent Type",
            "description": "Type of agent that was executed"
          },
          "is_default_project": {
            "type": "boolean",
            "title": "Is Default Project",
            "description": "Whether the task uses default project ID",
            "default": false
          }
        },
        "type": "object",
        "required": ["success", "task_id", "message", "user_id", "project_id", "agent_type"],
        "title": "SearchAgentResponse",
        "description": "Response model for search agent execution."
      },
      "SearchAgentStatusResponse": {
        "properties": {
          "task_id": { "type": "string", "title": "Task Id", "description": "Task ID" },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current status of the agent"
          },
          "progress": {
            "type": "integer",
            "title": "Progress",
            "description": "Progress percentage (0-100)"
          },
          "result": {
            "anyOf": [{ "additionalProperties": true, "type": "object" }, { "type": "null" }],
            "title": "Result",
            "description": "Result data if the agent completed successfully"
          },
          "error": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Error",
            "description": "Error message if the agent failed"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User ID associated with the task"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id",
            "description": "Project ID associated with the task"
          },
          "agent_type": { "type": "string", "title": "Agent Type", "description": "Type of agent" },
          "created_at": {
            "type": "number",
            "title": "Created At",
            "description": "Timestamp when the task was created"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At",
            "description": "Timestamp when the task was last updated"
          },
          "is_default_project": {
            "type": "boolean",
            "title": "Is Default Project",
            "description": "Whether the task uses default project ID",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "status",
          "progress",
          "user_id",
          "project_id",
          "agent_type",
          "created_at",
          "updated_at"
        ],
        "title": "SearchAgentStatusResponse",
        "description": "Response model for search agent status."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
