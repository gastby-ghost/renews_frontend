{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Service API - Material Bind",
    "description": "MediaAgent ReNews AI Content Creation Service - Module: material-bind",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/ai/document_generate/material-bind/execute": {
      "post": {
        "tags": ["Document Generate"],
        "summary": "Execute Material Bind",
        "description": "执行素材绑定\n\nArgs:\n    request: 包含用户ID、项目ID、标题、大纲章节和素材的请求\n\nReturns:\n    任务启动响应\n\nRaises:\n    HTTPException: 400 参数错误，500 内部错误",
        "operationId": "execute_material_bind_api_v1_ai_document_generate_material_bind_execute_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExecuteMaterialBindRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MaterialBindResult" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/document_generate/material-bind/status/{task_id}": {
      "get": {
        "tags": ["Document Generate"],
        "summary": "Get Material Bind Status",
        "description": "获取素材绑定任务状态\n\nArgs:\n    task_id: 任务ID\n\nReturns:\n    任务状态\n\nRaises:\n    HTTPException: 404 任务不存在，500 内部错误",
        "operationId": "get_material_bind_status_api_v1_ai_document_generate_material_bind_status__task_id__get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Task Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TaskStatus" } }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/document_generate/material-bind/cancel/{task_id}": {
      "post": {
        "tags": ["Document Generate"],
        "summary": "Cancel Material Bind Task",
        "description": "取消素材绑定任务\n\nArgs:\n    task_id: 任务ID\n\nReturns:\n    取消结果\n\nRaises:\n    HTTPException: 400 取消任务失败，500 内部错误",
        "operationId": "cancel_material_bind_task_api_v1_ai_document_generate_material_bind_cancel__task_id__post",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Task Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CancelTaskResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CancelTaskResponse": {
        "properties": {
          "task_id": { "type": "string", "title": "Task Id", "description": "任务ID" },
          "status": {
            "type": "string",
            "const": "cancelled",
            "title": "Status",
            "description": "任务状态",
            "default": "cancelled"
          },
          "message": { "type": "string", "title": "Message", "description": "响应消息" }
        },
        "type": "object",
        "required": ["task_id", "message"],
        "title": "CancelTaskResponse",
        "description": "取消任务响应模型"
      },
      "ExecuteMaterialBindRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "User Id",
            "description": "用户ID"
          },
          "project_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Project Id",
            "description": "项目ID"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "description": "新闻标题"
          },
          "outline_sections": {
            "items": { "$ref": "#/components/schemas/OutlineSection-Input" },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Outline Sections",
            "description": "大纲章节列表"
          },
          "materials": {
            "items": { "$ref": "#/components/schemas/Material" },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Materials",
            "description": "候选素材列表"
          }
        },
        "type": "object",
        "required": ["user_id", "project_id", "title", "outline_sections", "materials"],
        "title": "ExecuteMaterialBindRequest",
        "description": "执行素材绑定请求模型"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Material": {
        "properties": {
          "id": { "type": "integer", "minimum": 1.0, "title": "Id", "description": "素材ID" },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "description": "AI总结标题"
          },
          "summary": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Summary",
            "description": "摘要"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content",
            "description": "完整内容（JSON字符串）"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "相关性评分（0-1）"
          },
          "key_excerpts": {
            "items": { "type": "string" },
            "type": "array",
            "maxItems": 50,
            "title": "Key Excerpts",
            "description": "关键摘录列表"
          },
          "published_date": {
            "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }],
            "title": "Published Date",
            "description": "发布日期"
          },
          "source_url": {
            "anyOf": [{ "type": "string", "maxLength": 1000 }, { "type": "null" }],
            "title": "Source Url",
            "description": "来源URL"
          },
          "source_type": {
            "anyOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }],
            "title": "Source Type",
            "description": "来源类型"
          },
          "author": {
            "anyOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }],
            "title": "Author",
            "description": "作者"
          }
        },
        "type": "object",
        "required": ["id", "title", "summary", "content", "score"],
        "title": "Material",
        "description": "素材数据模型\n\n对应数据库中的 Material 表"
      },
      "MaterialBindResult": {
        "properties": {
          "task_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Task Id",
            "description": "任务ID"
          },
          "status": {
            "type": "string",
            "enum": ["started", "pending"],
            "title": "Status",
            "description": "任务状态"
          },
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Message",
            "description": "响应消息"
          }
        },
        "type": "object",
        "required": ["task_id", "status", "message"],
        "title": "MaterialBindResult",
        "description": "素材绑定结果模型"
      },
      "OutlineSection-Input": {
        "properties": {
          "id": { "type": "integer", "minimum": 1.0, "title": "Id", "description": "章节ID" },
          "outline_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Outline Id",
            "description": "大纲ID"
          },
          "section_title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Section Title",
            "description": "章节标题"
          },
          "content_direction": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Content Direction",
            "description": "内容方向"
          },
          "data_requirements": {
            "items": { "type": "string" },
            "type": "array",
            "maxItems": 20,
            "title": "Data Requirements",
            "description": "数据需求列表（JSON数组）"
          },
          "sources": {
            "items": { "additionalProperties": true, "type": "object" },
            "type": "array",
            "maxItems": 100,
            "title": "Sources",
            "description": "来源素材（JSON数组）"
          },
          "section_order": {
            "anyOf": [{ "type": "integer", "minimum": 0.0 }, { "type": "null" }],
            "title": "Section Order",
            "description": "章节顺序"
          },
          "estimated_words": {
            "anyOf": [{ "type": "integer", "minimum": 0.0 }, { "type": "null" }],
            "title": "Estimated Words",
            "description": "预估字数"
          }
        },
        "type": "object",
        "required": ["id", "outline_id", "section_title", "content_direction"],
        "title": "OutlineSection",
        "description": "大纲章节模型\n\n对应数据库中的 OutlineSection 表"
      },
      "TaskStatus": {
        "properties": {
          "task_id": { "type": "string", "title": "Task Id", "description": "任务ID" },
          "status": { "$ref": "#/components/schemas/TaskStatusEnum", "description": "任务状态" },
          "progress": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Progress",
            "description": "任务进度百分比",
            "default": 0
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "integer" },
                    { "type": "number" },
                    { "type": "boolean" },
                    { "items": {}, "type": "array" },
                    { "additionalProperties": true, "type": "object" }
                  ]
                },
                "type": "object"
              },
              { "type": "null" }
            ],
            "title": "Result",
            "description": "任务结果"
          },
          "error": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Error",
            "description": "错误信息"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "创建时间"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "更新时间"
          }
        },
        "type": "object",
        "required": ["task_id", "status", "created_at", "updated_at"],
        "title": "TaskStatus",
        "description": "任务状态模型（复用 session.py 中的定义）"
      },
      "TaskStatusEnum": {
        "type": "string",
        "enum": ["pending", "processing", "completed", "failed", "cancelled"],
        "title": "TaskStatusEnum",
        "description": "任务状态枚举"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
