{
  "openapi": "3.1.0",
  "info": {
    "title": "写作助手核心服务",
    "description": "提供写作助手的核心功能API",
    "version": "1.0.0"
  },
  "servers": [],
  "components": {
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "app__statistics__schemas__ComponentType": {
        "type": "string",
        "enum": ["requirement", "title", "outline", "content", "material"],
        "title": "ComponentType",
        "description": "组件类型"
      },
      "ReportExportRequest": {
        "properties": {
          "project_id": {
            "type": "integer",
            "title": "Project Id",
            "description": "项目ID"
          },
          "export_format": {
            "$ref": "#/components/schemas/app__statistics__schemas__ExportFormat"
          },
          "include_content": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Include Content",
            "description": "包含的内容选项"
          },
          "report_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report Title",
            "description": "自定义报告标题"
          },
          "include_charts": {
            "type": "boolean",
            "title": "Include Charts",
            "description": "是否包含图表",
            "default": true
          }
        },
        "type": "object",
        "required": ["project_id", "export_format"],
        "title": "ReportExportRequest",
        "description": "报告导出请求"
      },
      "ReportExportResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "导出是否成功"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "导出任务ID"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "导出状态"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "响应消息"
          },
          "estimated_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Time",
            "description": "预估完成时间"
          }
        },
        "type": "object",
        "required": ["success", "task_id", "status", "message"],
        "title": "ReportExportResponse",
        "description": "报告导出响应"
      },
      "WritingStatisticsResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "请求是否成功"
          },
          "project_stats": {
            "$ref": "#/components/schemas/ProjectOverallStats"
          },
          "component_stats": {
            "items": {
              "$ref": "#/components/schemas/ComponentStats"
            },
            "type": "array",
            "title": "Component Stats",
            "description": "组件统计列表"
          },
          "current_component_stats": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ComponentStats"
              },
              {
                "type": "null"
              }
            ],
            "description": "当前组件统计"
          },
          "summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Summary",
            "description": "统计摘要"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At",
            "description": "统计生成时间"
          }
        },
        "type": "object",
        "required": ["success", "project_stats", "component_stats", "summary", "generated_at"],
        "title": "WritingStatisticsResponse",
        "description": "写作统计响应"
      },
      "ReportExportStatus": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "导出任务ID"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "导出状态"
          },
          "progress": {
            "type": "number",
            "title": "Progress",
            "description": "导出进度"
          },
          "current_step": {
            "type": "string",
            "title": "Current Step",
            "description": "当前步骤"
          },
          "estimated_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Time",
            "description": "预估完成时间"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "创建时间"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "更新时间"
          }
        },
        "type": "object",
        "required": ["task_id", "status", "progress", "current_step", "created_at", "updated_at"],
        "title": "ReportExportStatus",
        "description": "报告导出状态"
      },
      "ComponentStats": {
        "properties": {
          "component_type": {
            "$ref": "#/components/schemas/app__statistics__schemas__ComponentType"
          },
          "component_name": {
            "type": "string",
            "title": "Component Name",
            "description": "组件名称"
          },
          "completion_status": {
            "$ref": "#/components/schemas/CompletionStatus"
          },
          "completion_percentage": {
            "type": "number",
            "title": "Completion Percentage",
            "description": "完成百分比"
          },
          "word_count": {
            "$ref": "#/components/schemas/WordCountStats"
          },
          "readability": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReadabilityStats"
              },
              {
                "type": "null"
              }
            ],
            "description": "可读性统计"
          },
          "last_updated": {
            "type": "string",
            "format": "date-time",
            "title": "Last Updated",
            "description": "最后更新时间"
          },
          "estimated_reading_time": {
            "type": "integer",
            "title": "Estimated Reading Time",
            "description": "预估阅读时间(分钟)"
          }
        },
        "type": "object",
        "required": [
          "component_type",
          "component_name",
          "completion_status",
          "completion_percentage",
          "word_count",
          "last_updated",
          "estimated_reading_time"
        ],
        "title": "ComponentStats",
        "description": "组件统计"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "WritingStatisticsRequest": {
        "properties": {
          "project_id": {
            "type": "integer",
            "title": "Project Id",
            "description": "项目ID"
          },
          "component_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/app__statistics__schemas__ComponentType"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": ["project_id"],
        "title": "WritingStatisticsRequest",
        "description": "写作统计请求"
      },
      "ReportExportResult": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "导出任务ID"
          },
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "导出是否成功"
          },
          "file_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Url",
            "description": "文件下载URL"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "文件大小(字节)"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "文件名"
          },
          "export_format": {
            "$ref": "#/components/schemas/app__statistics__schemas__ExportFormat"
          },
          "include_content": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Include Content",
            "description": "包含的内容"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Completed At",
            "description": "完成时间"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message",
            "description": "错误信息"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "success",
          "filename",
          "export_format",
          "include_content",
          "completed_at"
        ],
        "title": "ReportExportResult",
        "description": "报告导出结果"
      }
    }
  },
  "paths": {
    "/api/v1/core/statistics/writing": {
      "post": {
        "tags": ["写作统计"],
        "summary": "Get Writing Statistics",
        "description": "获取写作统计信息\n\n提供项目和组件的详细统计数据，包括完成度、字数、可读性等",
        "operationId": "get_writing_statistics_api_v1_core_statistics_writing_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WritingStatisticsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WritingStatisticsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/core/statistics/writing/project/{project_id}": {
      "get": {
        "tags": ["写作统计"],
        "summary": "Get Project Writing Statistics",
        "description": "获取指定项目的写作统计信息\n\n根据项目ID获取详细的写作统计数据",
