        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Project Id"
            }
          },
          {
            "name": "component_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/app__statistics__schemas__ComponentType"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Component Type"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
