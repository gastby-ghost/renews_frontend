      "get": {
        "tags": ["写作统计"],
        "summary": "Get Component Writing Statistics",
        "description": "获取指定组件的写作统计信息\n\n根据项目ID和组件类型获取特定组件的统计数据",
        "operationId": "get_component_writing_statistics_api_v1_core_statistics_writing_component__project_id___component_type__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Project Id"
            }
          },
          {
            "name": "component_type",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/app__statistics__schemas__ComponentType"
            }
          }
