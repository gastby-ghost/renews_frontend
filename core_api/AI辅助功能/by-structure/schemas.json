{
  "CrossComponentOptimizationRequest": {
    "properties": {
      "project_data": {
        "additionalProperties": true,
        "type": "object",
        "title": "Project Data",
        "description": "项目数据"
      },
      "component_relationships": {
        "$ref": "#/components/schemas/ComponentRelationship",
        "description": "组件关系数据"
      },
      "analysis_depth": {
        "type": "string",
        "enum": ["basic", "standard", "comprehensive"],
        "title": "Analysis Depth",
        "description": "分析深度",
        "default": "standard"
      }
    },
    "type": "object",
    "required": ["project_data", "component_relationships"],
    "title": "CrossComponentOptimizationRequest",
    "description": "跨组件优化请求模型"
  },
  "app__ai__schemas__ComponentType": {
    "type": "string",
    "enum": ["requirement", "title", "outline", "content", "material"],
    "title": "ComponentType",
    "description": "组件类型枚举"
  },
  "CrossComponentOptimizationResponse": {
    "properties": {
      "analysis": {
        "$ref": "#/components/schemas/CrossComponentAnalysis",
        "description": "分析结果"
      },
      "suggestions": {
        "items": {
          "$ref": "#/components/schemas/AISuggestion"
        },
        "type": "array",
        "title": "Suggestions",
        "description": "优化建议列表"
      },
      "total_count": {
        "type": "integer",
        "title": "Total Count",
        "description": "建议总数"
      },
      "analysis_timestamp": {
        "type": "string",
        "format": "date-time",
        "title": "Analysis Timestamp",
        "description": "分析时间"
      }
    },
    "type": "object",
    "required": ["analysis", "suggestions", "total_count", "analysis_timestamp"],
    "title": "CrossComponentOptimizationResponse",
    "description": "跨组件优化响应模型"
  },
  "HTTPValidationError": {
    "properties": {
      "detail": {
        "items": {
          "$ref": "#/components/schemas/ValidationError"
        },
        "type": "array",
        "title": "Detail"
      }
    },
    "type": "object",
    "title": "HTTPValidationError"
  },
  "SuggestionFeedback": {
    "properties": {
      "suggestion_id": {
        "type": "string",
        "title": "Suggestion Id",
        "description": "建议ID"
      },
      "rating": {
        "type": "integer",
        "maximum": 5.0,
        "minimum": 1.0,
        "title": "Rating",
        "description": "评分(1-5)"
      },
      "feedback": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Feedback",
        "description": "反馈内容"
      },
      "applied": {
        "type": "boolean",
        "title": "Applied",
        "description": "是否应用了建议"
      }
    },
    "type": "object",
    "required": ["suggestion_id", "rating", "applied"],
    "title": "SuggestionFeedback",
    "description": "建议反馈模型"
  },
  "SuggestionFeedbackResponse": {
    "properties": {
      "success": {
        "type": "boolean",
        "title": "Success",
        "description": "反馈提交是否成功"
      },
      "message": {
        "type": "string",
        "title": "Message",
        "description": "反馈结果消息"
      }
    },
    "type": "object",
    "required": ["success", "message"],
    "title": "SuggestionFeedbackResponse",
    "description": "建议反馈响应模型"
  },
  "AISuggestion": {
    "properties": {
      "id": {
        "type": "string",
        "title": "Id",
        "description": "建议ID"
      },
      "content": {
        "type": "string",
        "title": "Content",
        "description": "建议内容"
      },
      "priority": {
        "$ref": "#/components/schemas/SuggestionPriority",
        "description": "建议优先级"
      },
      "impact": {
        "$ref": "#/components/schemas/SuggestionImpact",
        "description": "影响范围"
      },
      "component_type": {
        "$ref": "#/components/schemas/app__ai__schemas__ComponentType",
        "description": "相关组件类型"
      },
      "reasoning": {
        "type": "string",
        "title": "Reasoning",
        "description": "建议理由"
      },
      "estimated_effort": {
        "type": "string",
        "title": "Estimated Effort",
        "description": "预估工作量"
      },
      "created_at": {
        "type": "string",
        "format": "date-time",
        "title": "Created At",
        "description": "创建时间"
      }
    },
    "type": "object",
    "required": [
      "id",
      "content",
      "priority",
      "impact",
      "component_type",
      "reasoning",
      "estimated_effort",
      "created_at"
    ],
    "title": "AISuggestion",
    "description": "AI建议模型"
  },
  "ApplySuggestionRequest": {
    "properties": {
      "suggestion_id": {
        "type": "string",
        "title": "Suggestion Id",
        "description": "建议ID"
      },
      "project_id": {
        "type": "integer",
        "title": "Project Id",
        "description": "项目ID"
      },
      "auto_apply": {
        "type": "boolean",
        "title": "Auto Apply",
        "description": "是否自动应用",
        "default": false
      }
    },
    "type": "object",
    "required": ["suggestion_id", "project_id"],
    "title": "ApplySuggestionRequest",
    "description": "应用建议请求模型"
  },
  "AISuggestionRequest": {
    "properties": {
      "component_type": {
        "$ref": "#/components/schemas/app__ai__schemas__ComponentType",
        "description": "当前组件类型"
      },
      "project_data": {
        "additionalProperties": true,
        "type": "object",
        "title": "Project Data",
        "description": "项目数据"
      },
      "context": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "title": "Context",
        "description": "上下文信息"
      }
    },
    "type": "object",
    "required": ["component_type", "project_data"],
    "title": "AISuggestionRequest",
    "description": "AI建议请求模型"
  },
  "AISuggestionResponse": {
    "properties": {
      "suggestions": {
        "items": {
          "$ref": "#/components/schemas/AISuggestion"
        },
        "type": "array",
        "title": "Suggestions",
        "description": "建议列表"
      },
      "total_count": {
        "type": "integer",
        "title": "Total Count",
        "description": "建议总数"
      },
      "component_type": {
        "$ref": "#/components/schemas/app__ai__schemas__ComponentType",
        "description": "当前组件类型"
      }
    },
    "type": "object",
    "required": ["suggestions", "total_count", "component_type"],
    "title": "AISuggestionResponse",
    "description": "AI建议响应模型"
  },
  "ApplySuggestionResponse": {
    "properties": {
      "success": {
        "type": "boolean",
        "title": "Success",
        "description": "应用是否成功"
      },
      "message": {
        "type": "string",
        "title": "Message",
        "description": "应用结果消息"
      },
      "applied_changes": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "title": "Applied Changes",
        "description": "应用的变更内容"
      },
      "applied_at": {
        "type": "string",
        "format": "date-time",
        "title": "Applied At",
        "description": "应用时间"
      }
    },
    "type": "object",
    "required": ["success", "message", "applied_at"],
    "title": "ApplySuggestionResponse",
    "description": "应用建议响应模型"
  }
}
