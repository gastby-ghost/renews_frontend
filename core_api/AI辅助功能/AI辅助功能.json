{
  "openapi": "3.1.0",
  "info": {
    "title": "写作助手核心服务",
    "description": "提供写作助手的核心功能API",
    "version": "1.0.0"
  },
  "servers": [],
  "components": {
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CrossComponentOptimizationRequest": {
        "properties": {
          "project_data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Project Data",
            "description": "项目数据"
          },
          "component_relationships": {
            "$ref": "#/components/schemas/ComponentRelationship",
            "description": "组件关系数据"
          },
          "analysis_depth": {
            "type": "string",
            "enum": ["basic", "standard", "comprehensive"],
            "title": "Analysis Depth",
            "description": "分析深度",
            "default": "standard"
          }
        },
        "type": "object",
        "required": ["project_data", "component_relationships"],
        "title": "CrossComponentOptimizationRequest",
        "description": "跨组件优化请求模型"
      },
      "app__ai__schemas__ComponentType": {
        "type": "string",
        "enum": ["requirement", "title", "outline", "content", "material"],
        "title": "ComponentType",
        "description": "组件类型枚举"
      },
      "CrossComponentOptimizationResponse": {
        "properties": {
          "analysis": {
            "$ref": "#/components/schemas/CrossComponentAnalysis",
            "description": "分析结果"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/AISuggestion"
            },
            "type": "array",
            "title": "Suggestions",
            "description": "优化建议列表"
          },
          "total_count": {
            "type": "integer",
            "title": "Total Count",
            "description": "建议总数"
          },
          "analysis_timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Analysis Timestamp",
            "description": "分析时间"
          }
        },
        "type": "object",
        "required": ["analysis", "suggestions", "total_count", "analysis_timestamp"],
        "title": "CrossComponentOptimizationResponse",
        "description": "跨组件优化响应模型"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SuggestionFeedback": {
        "properties": {
          "suggestion_id": {
            "type": "string",
            "title": "Suggestion Id",
            "description": "建议ID"
          },
          "rating": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating",
            "description": "评分(1-5)"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback",
            "description": "反馈内容"
          },
          "applied": {
            "type": "boolean",
            "title": "Applied",
            "description": "是否应用了建议"
          }
        },
        "type": "object",
        "required": ["suggestion_id", "rating", "applied"],
        "title": "SuggestionFeedback",
        "description": "建议反馈模型"
      },
      "SuggestionFeedbackResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "反馈提交是否成功"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "反馈结果消息"
          }
        },
        "type": "object",
        "required": ["success", "message"],
        "title": "SuggestionFeedbackResponse",
        "description": "建议反馈响应模型"
      },
      "AISuggestion": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "建议ID"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "建议内容"
          },
          "priority": {
            "$ref": "#/components/schemas/SuggestionPriority",
            "description": "建议优先级"
          },
          "impact": {
            "$ref": "#/components/schemas/SuggestionImpact",
            "description": "影响范围"
          },
          "component_type": {
            "$ref": "#/components/schemas/app__ai__schemas__ComponentType",
            "description": "相关组件类型"
          },
          "reasoning": {
            "type": "string",
            "title": "Reasoning",
            "description": "建议理由"
          },
          "estimated_effort": {
            "type": "string",
            "title": "Estimated Effort",
            "description": "预估工作量"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "创建时间"
          }
        },
        "type": "object",
        "required": [
          "id",
          "content",
          "priority",
          "impact",
          "component_type",
          "reasoning",
          "estimated_effort",
          "created_at"
        ],
        "title": "AISuggestion",
        "description": "AI建议模型"
      },
      "ApplySuggestionRequest": {
        "properties": {
          "suggestion_id": {
            "type": "string",
            "title": "Suggestion Id",
            "description": "建议ID"
          },
          "project_id": {
            "type": "integer",
            "title": "Project Id",
            "description": "项目ID"
          },
          "auto_apply": {
            "type": "boolean",
            "title": "Auto Apply",
            "description": "是否自动应用",
            "default": false
          }
        },
        "type": "object",
        "required": ["suggestion_id", "project_id"],
        "title": "ApplySuggestionRequest",
        "description": "应用建议请求模型"
      },
      "AISuggestionRequest": {
        "properties": {
          "component_type": {
            "$ref": "#/components/schemas/app__ai__schemas__ComponentType",
            "description": "当前组件类型"
          },
          "project_data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Project Data",
            "description": "项目数据"
          },
          "context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context",
            "description": "上下文信息"
          }
        },
        "type": "object",
        "required": ["component_type", "project_data"],
        "title": "AISuggestionRequest",
        "description": "AI建议请求模型"
      },
      "AISuggestionResponse": {
        "properties": {
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/AISuggestion"
            },
            "type": "array",
            "title": "Suggestions",
            "description": "建议列表"
          },
          "total_count": {
            "type": "integer",
            "title": "Total Count",
            "description": "建议总数"
          },
          "component_type": {
            "$ref": "#/components/schemas/app__ai__schemas__ComponentType",
            "description": "当前组件类型"
          }
        },
        "type": "object",
        "required": ["suggestions", "total_count", "component_type"],
        "title": "AISuggestionResponse",
        "description": "AI建议响应模型"
      },
      "ApplySuggestionResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "应用是否成功"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "应用结果消息"
          },
          "applied_changes": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applied Changes",
            "description": "应用的变更内容"
          },
          "applied_at": {
            "type": "string",
            "format": "date-time",
            "title": "Applied At",
            "description": "应用时间"
          }
        },
        "type": "object",
        "required": ["success", "message", "applied_at"],
        "title": "ApplySuggestionResponse",
        "description": "应用建议响应模型"
      }
    }
  },
  "paths": {
    "/api/v1/core/ai/suggestions": {
      "post": {
        "tags": ["AI辅助功能"],
        "summary": "Get Ai Suggestions",
        "description": "获取AI优化建议\n\n根据当前组件类型和项目数据，生成相应的AI优化建议",
        "operationId": "get_ai_suggestions_api_v1_core_ai_suggestions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AISuggestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AISuggestionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/core/ai/suggestions/apply": {
      "post": {
        "tags": ["AI辅助功能"],
        "summary": "Apply Ai Suggestion",
        "description": "应用AI建议\n\n将AI生成的建议应用到项目中",
        "operationId": "apply_ai_suggestion_api_v1_core_ai_suggestions_apply_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplySuggestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplySuggestionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/core/ai/suggestions/feedback": {
      "post": {
        "tags": ["AI辅助功能"],
        "summary": "Submit Suggestion Feedback",
        "description": "提交建议反馈\n\n用户对AI建议的评分和反馈",
        "operationId": "submit_suggestion_feedback_api_v1_core_ai_suggestions_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuggestionFeedback"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestionFeedbackResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/core/ai/suggestions/component/{component_type}": {
      "get": {
        "tags": ["AI辅助功能"],
        "summary": "Get Component Suggestions",
        "description": "获取特定组件的AI建议\n\n根据组件类型和项目ID获取相关的AI建议",
        "operationId": "get_component_suggestions_api_v1_core_ai_suggestions_component__component_type__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "component_type",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/app__ai__schemas__ComponentType"
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AISuggestionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/core/ai/suggestions/project/{project_id}": {
      "get": {
        "tags": ["AI辅助功能"],
        "summary": "Get Project Suggestions",
        "description": "获取项目的所有AI建议\n\n获取指定项目的所有组件建议",
        "operationId": "get_project_suggestions_api_v1_core_ai_suggestions_project__project_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AISuggestion"
                  },
                  "title": "Response Get Project Suggestions Api V1 Core Ai Suggestions Project  Project Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/core/ai/cross-component-optimization": {
      "post": {
        "tags": ["AI辅助功能"],
        "summary": "Analyze Cross Component Optimization",
        "description": "分析跨组件优化建议\n\n分析项目各组件间的一致性和关联性，提供跨组件的优化建议",
        "operationId": "analyze_cross_component_optimization_api_v1_core_ai_cross_component_optimization_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrossComponentOptimizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrossComponentOptimizationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/core/ai/cross-component-optimization/project/{project_id}": {
      "get": {
        "tags": ["AI辅助功能"],
        "summary": "Get Project Cross Component Optimization",
        "description": "获取项目的跨组件优化分析\n\n基于项目ID获取跨组件优化建议",
        "operationId": "get_project_cross_component_optimization_api_v1_core_ai_cross_component_optimization_project__project_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Project Id"
            }
          },
          {
            "name": "analysis_depth",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "standard",
              "title": "Analysis Depth"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrossComponentOptimizationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "AI辅助功能",
      "description": "AI辅助功能 相关的 API"
    }
  ]
}
