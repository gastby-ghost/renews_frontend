{
  "openapi": "3.1.0",
  "info": {
    "title": "写作助手核心服务",
    "description": "提供写作助手的核心功能API",
    "version": "1.0.0"
  },
  "servers": [],
  "components": {
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ShortcutListResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "操作是否成功"
          },
          "shortcuts": {
            "items": {
              "$ref": "#/components/schemas/ShortcutDefinition"
            },
            "type": "array",
            "title": "Shortcuts",
            "description": "快捷键列表"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories",
            "description": "分类列表"
          },
          "total_count": {
            "type": "integer",
            "title": "Total Count",
            "description": "总数量"
          },
          "context": {
            "$ref": "#/components/schemas/ShortcutContext",
            "description": "当前上下文"
          }
        },
        "type": "object",
        "required": ["success", "shortcuts", "categories", "total_count", "context"],
        "title": "ShortcutListResponse",
        "description": "快捷键列表响应"
      },
      "ShortcutConfig-Output": {
        "properties": {
          "enable_global_shortcuts": {
            "type": "boolean",
            "title": "Enable Global Shortcuts",
            "description": "是否启用全局快捷键",
            "default": true
          },
          "enable_sound_feedback": {
            "type": "boolean",
            "title": "Enable Sound Feedback",
            "description": "是否启用声音反馈",
            "default": true
          },
          "enable_visual_feedback": {
            "type": "boolean",
            "title": "Enable Visual Feedback",
            "description": "是否启用视觉反馈",
            "default": true
          },
          "default_context": {
            "$ref": "#/components/schemas/ShortcutContext",
            "description": "默认上下文",
            "default": "global"
          },
          "custom_shortcuts": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ShortcutDefinition"
            },
            "type": "object",
            "title": "Custom Shortcuts",
            "description": "自定义快捷键",
            "default": {}
          }
        },
        "type": "object",
        "title": "ShortcutConfig",
        "description": "快捷键配置"
      },
      "ShortcutContext": {
        "type": "string",
        "enum": ["global", "project", "component", "editor"],
        "title": "ShortcutContext",
        "description": "快捷键上下文枚举"
      },
      "ShortcutHelpResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "操作是否成功"
          },
          "shortcuts_by_category": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/ShortcutDefinition"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Shortcuts By Category",
            "description": "按分类组织的快捷键"
          },
          "total_shortcuts": {
            "type": "integer",
            "title": "Total Shortcuts",
            "description": "总快捷键数量"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories",
            "description": "所有分类"
          }
        },
        "type": "object",
        "required": ["success", "shortcuts_by_category", "total_shortcuts", "categories"],
        "title": "ShortcutHelpResponse",
        "description": "快捷键帮助响应"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ShortcutCustomizeRequest": {
        "properties": {
          "shortcut_id": {
            "type": "string",
            "title": "Shortcut Id",
            "description": "快捷键ID"
          },
          "new_key_combination": {
            "type": "string",
            "title": "New Key Combination",
            "description": "新的按键组合"
          },
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ShortcutContext"
              },
              {
                "type": "null"
              }
            ],
            "description": "新的上下文"
          },
          "is_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Enabled",
            "description": "是否启用"
          }
        },
        "type": "object",
        "required": ["shortcut_id", "new_key_combination"],
        "title": "ShortcutCustomizeRequest",
        "description": "自定义快捷键请求"
      },
      "ShortcutResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "操作是否成功"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "响应消息"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ShortcutAction"
              },
              {
                "type": "null"
              }
            ],
            "description": "执行的动作"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result",
            "description": "操作结果"
          },
          "execution_time": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Execution Time",
            "description": "执行时间（毫秒）"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "时间戳"
          }
        },
        "type": "object",
        "required": ["success", "message"],
        "title": "ShortcutResponse",
        "description": "快捷键响应"
      },
      "ShortcutConfig-Input": {
        "properties": {
          "enable_global_shortcuts": {
            "type": "boolean",
            "title": "Enable Global Shortcuts",
            "description": "是否启用全局快捷键",
            "default": true
          },
          "enable_sound_feedback": {
            "type": "boolean",
            "title": "Enable Sound Feedback",
            "description": "是否启用声音反馈",
            "default": true
          },
          "enable_visual_feedback": {
            "type": "boolean",
            "title": "Enable Visual Feedback",
            "description": "是否启用视觉反馈",
            "default": true
          },
          "default_context": {
            "$ref": "#/components/schemas/ShortcutContext",
            "description": "默认上下文",
            "default": "global"
          },
          "custom_shortcuts": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ShortcutDefinition"
            },
            "type": "object",
            "title": "Custom Shortcuts",
            "description": "自定义快捷键",
            "default": {}
          }
        },
        "type": "object",
        "title": "ShortcutConfig",
        "description": "快捷键配置"
      },
      "ShortcutRequest": {
        "properties": {
          "key_combination": {
            "type": "string",
            "title": "Key Combination",
            "description": "快捷键组合"
          },
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ShortcutContext"
              },
              {
                "type": "null"
              }
            ],
            "description": "当前上下文",
            "default": "global"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id",
            "description": "项目ID（项目相关操作需要）"
          },
          "component_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Component Type",
            "description": "组件类型（组件相关操作需要）"
          },
          "additional_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Additional Data",
            "description": "额外数据",
            "default": {}
          }
        },
        "type": "object",
        "required": ["key_combination"],
        "title": "ShortcutRequest",
        "description": "快捷键请求"
      },
      "ShortcutCustomizeResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "操作是否成功"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "响应消息"
          },
          "updated_shortcut": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ShortcutDefinition"
              },
              {
                "type": "null"
              }
            ],
            "description": "更新后的快捷键"
          },
          "conflicts": {
            "items": {
              "$ref": "#/components/schemas/ShortcutConflict"
            },
            "type": "array",
            "title": "Conflicts",
            "description": "冲突信息",
            "default": []
          }
        },
        "type": "object",
        "required": ["success", "message"],
        "title": "ShortcutCustomizeResponse",
        "description": "自定义快捷键响应"
      }
    }
  },
  "paths": {
    "/api/v1/core/shortcuts/execute": {
      "post": {
        "tags": ["快捷键支持"],
        "summary": "Execute Shortcut",
        "description": "执行快捷键操作",
        "operationId": "execute_shortcut_api_v1_core_shortcuts_execute_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShortcutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortcutResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/core/shortcuts/list/{context}": {
      "get": {
        "tags": ["快捷键支持"],
        "summary": "Get Shortcuts List",
        "description": "获取指定上下文的快捷键列表",
        "operationId": "get_shortcuts_list_api_v1_core_shortcuts_list__context__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "context",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ShortcutContext"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortcutListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/core/shortcuts/customize": {
      "post": {
        "tags": ["快捷键支持"],
        "summary": "Customize Shortcut",
        "description": "自定义快捷键",
        "operationId": "customize_shortcut_api_v1_core_shortcuts_customize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShortcutCustomizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortcutCustomizeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/core/shortcuts/help": {
      "get": {
        "tags": ["快捷键支持"],
        "summary": "Get Shortcut Help",
        "description": "获取快捷键帮助信息",
        "operationId": "get_shortcut_help_api_v1_core_shortcuts_help_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortcutHelpResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/core/shortcuts/config": {
      "put": {
        "tags": ["快捷键支持"],
        "summary": "Update Shortcut Config",
        "description": "更新用户快捷键配置",
        "operationId": "update_shortcut_config_api_v1_core_shortcuts_config_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShortcutConfig-Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortcutConfig-Output"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/core/shortcuts/reset": {
      "post": {
        "tags": ["快捷键支持"],
        "summary": "Reset User Shortcuts",
        "description": "重置用户快捷键到默认值",
        "operationId": "reset_user_shortcuts_api_v1_core_shortcuts_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/core/shortcuts/health": {
      "get": {
        "tags": ["快捷键支持"],
        "summary": "Health Check",
        "description": "健康检查",
        "operationId": "health_check_api_v1_core_shortcuts_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "快捷键支持",
      "description": "快捷键支持 相关的 API"
    }
  ]
}
