  "/api/v1/core/projects/{project_id}/materials": {
    "get": {
      "tags": ["素材管理"],
      "summary": "Get Project Materials",
      "description": "获取项目关联的素材",
      "operationId": "get_project_materials_api_v1_core_projects__project_id__materials_get",
      "security": [
        {
          "HTTPBearer": []
        }
      ],
      "parameters": [
        {
          "name": "project_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "项目ID，必须为正整数",
            "title": "Project Id"
          },
          "description": "项目ID，必须为正整数"
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "default": 1,
            "title": "Page"
          }
        },
        {
          "name": "page_size",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "default": 20,
            "title": "Page Size"
          }
        },
        {
          "name": "keywords",
          "in": "query",
          "required": false,
          "schema": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Keywords"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tags"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Successful Response",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MaterialListResponse"
              }
            }
          }
        },
        "422": {
          "description": "Validation Error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HTTPValidationError"
              }
            }
          }
        }
      }
    }
  },
