  "paths": {
    "/api/v1/core/export/create": {
      "post": {
        "tags": ["成稿导出"],
        "summary": "Create Export Task",
        "description": "创建导出任务\n\n创建文档导出任务，支持多种格式和范围选择",
        "operationId": "create_export_task_api_v1_core_export_create_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportProgress"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
