{
  "openapi": "3.1.0",
  "info": {
    "title": "写作助手核心服务",
    "description": "提供写作助手的核心功能API",
    "version": "1.0.0"
  },
  "servers": [],
  "components": {
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ExportResult": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "导出任务ID"
          },
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "导出是否成功"
          },
          "file_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Url",
            "description": "导出文件下载链接"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "文件大小(字节)"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "导出文件名"
          },
          "export_format": {
            "$ref": "#/components/schemas/app__export__schemas__ExportFormat",
            "description": "导出格式"
          },
          "export_range": {
            "$ref": "#/components/schemas/ExportRange",
            "description": "导出范围"
          },
          "export_options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExportOptions"
              },
              {
                "type": "null"
              }
            ],
            "description": "导出选项"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Completed At",
            "description": "完成时间"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message",
            "description": "错误信息"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "success",
          "filename",
          "export_format",
          "export_range",
          "completed_at"
        ],
        "title": "ExportResult",
        "description": "导出结果模型"
      },
      "ExportRequest": {
        "properties": {
          "project_id": {
            "type": "integer",
            "title": "Project Id",
            "description": "项目ID"
          },
          "export_format": {
            "$ref": "#/components/schemas/app__export__schemas__ExportFormat",
            "description": "导出格式"
          },
          "export_range": {
            "$ref": "#/components/schemas/ExportRange",
            "description": "导出范围"
          },
          "export_options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExportOptions"
              },
              {
                "type": "null"
              }
            ],
            "description": "导出选项"
          },
          "filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename",
            "description": "自定义文件名"
          }
        },
        "type": "object",
        "required": ["project_id", "export_format", "export_range"],
        "title": "ExportRequest",
        "description": "导出请求模型"
      },
      "ExportHistory": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "导出记录ID"
          },
          "project_id": {
            "type": "integer",
            "title": "Project Id",
            "description": "项目ID"
          },
          "user_id": {
            "type": "integer",
            "title": "User Id",
            "description": "用户ID"
          },
          "export_format": {
            "$ref": "#/components/schemas/app__export__schemas__ExportFormat",
            "description": "导出格式"
          },
          "export_range": {
            "$ref": "#/components/schemas/ExportRange",
            "description": "导出范围"
          },
          "export_options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExportOptions"
              },
              {
                "type": "null"
              }
            ],
            "description": "导出选项"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "导出文件名"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "文件大小"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "导出状态"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "创建时间"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At",
            "description": "完成时间"
          },
          "download_count": {
            "type": "integer",
            "title": "Download Count",
            "description": "下载次数",
            "default": 0
          }
