      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ExportProgress": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "导出任务ID"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "导出状态"
          },
          "progress": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Progress",
            "description": "导出进度百分比"
