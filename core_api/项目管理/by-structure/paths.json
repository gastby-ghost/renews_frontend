{
  "/api/v1/core/projects": {
    "get": {
      "tags": ["项目管理"],
      "summary": "Get User Projects",
      "description": "获取用户项目列表\n\n支持功能：\n1. 分页查询\n2. 状态筛选\n3. 关键词搜索\n4. 文件夹筛选\n\n排序规则：按最后修改时间倒序排列",
      "operationId": "get_user_projects_api_v1_core_projects_get",
      "security": [
        {
          "HTTPBearer": []
        }
      ],
      "parameters": [
        {
          "name": "page",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "description": "页码",
            "default": 1,
            "title": "Page"
          },
          "description": "页码"
        },
        {
          "name": "page_size",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "maximum": 100,
            "minimum": 1,
            "description": "每页数量",
            "default": 20,
            "title": "Page Size"
          },
          "description": "每页数量"
        },
        {
          "name": "status",
          "in": "query",
          "required": false,
          "schema": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "项目状态筛选",
            "title": "Status"
          },
          "description": "项目状态筛选"
        },
        {
          "name": "keywords",
          "in": "query",
          "required": false,
          "schema": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "关键词搜索（项目名称）",
            "title": "Keywords"
          },
          "description": "关键词搜索（项目名称）"
        },
        {
          "name": "folder_id",
          "in": "query",
          "required": false,
          "schema": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "文件夹ID筛选",
            "title": "Folder Id"
          },
          "description": "文件夹ID筛选"
        }
      ],
      "responses": {
        "200": {
          "description": "Successful Response",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectListResponse"
              }
            }
          }
        },
        "422": {
          "description": "Validation Error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HTTPValidationError"
              }
            }
          }
        }
      }
    }
  },
  "/api/v1/core/projects/{project_id}": {
    "put": {
      "tags": ["项目管理"],
      "summary": "Update Project",
      "description": "更新项目信息\n\n业务规则：\n1. 项目名称必须唯一（用户维度，排除当前项目）\n2. 更新时自动更新最后修改时间\n\n异常处理：\n- 项目不存在 → 404错误\n- 项目名称已存在 → 提示\"项目名称已存在\"",
      "operationId": "update_project_api_v1_core_projects__project_id__put",
      "security": [
        {
          "HTTPBearer": []
        }
      ],
      "parameters": [
        {
          "name": "project_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "项目ID",
            "title": "Project Id"
          },
          "description": "项目ID"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProjectUpdate"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Successful Response",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectDetailResponse"
              }
            }
          }
        },
        "422": {
          "description": "Validation Error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HTTPValidationError"
              }
            }
          }
        }
      }
    }
  },
  "/api/v1/core/projects/batch": {
    "delete": {
      "tags": ["项目管理"],
      "summary": "Delete Projects",
      "description": "批量删除项目\n\n业务规则：\n1. 支持批量删除，最多100个项目\n2. 只删除用户拥有的项目\n3. 返回详细的删除结果",
      "operationId": "delete_projects_api_v1_core_projects_batch_delete",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProjectDeleteRequest"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "description": "Successful Response",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectDeleteResponse"
              }
            }
          }
        },
        "422": {
          "description": "Validation Error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HTTPValidationError"
              }
            }
          }
        }
      },
      "security": [
        {
          "HTTPBearer": []
        }
      ]
    }
  },
