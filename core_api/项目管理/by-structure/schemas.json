{
  "ProjectStatusUpdateRequest": {
    "properties": {
      "status": {
        "type": "string",
        "maxLength": 20,
        "title": "Status",
        "description": "新的项目状态"
      }
    },
    "type": "object",
    "required": ["status"],
    "title": "ProjectStatusUpdateRequest",
    "description": "项目状态更新请求"
  },
  "ProjectUpdate": {
    "properties": {
      "name": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 50,
            "minLength": 1
          },
          {
            "type": "null"
          }
        ],
        "title": "Name",
        "description": "项目名称"
      },
      "status": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 20
          },
          {
            "type": "null"
          }
        ],
        "title": "Status",
        "description": "项目状态"
      },
      "current_component": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 20
          },
          {
            "type": "null"
          }
        ],
        "title": "Current Component",
        "description": "当前组件"
      },
      "folder_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Folder Id",
        "description": "文件夹ID"
      }
    },
    "type": "object",
    "title": "ProjectUpdate",
    "description": "更新项目请求"
  },
  "ProjectDeleteResponse": {
    "properties": {
      "success": {
        "type": "boolean",
        "title": "Success"
      },
      "message": {
        "type": "string",
        "title": "Message"
      },
      "deleted_count": {
        "type": "integer",
        "title": "Deleted Count"
      },
      "failed_count": {
        "type": "integer",
        "title": "Failed Count"
      },
      "details": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "type": "array",
        "title": "Details",
        "description": "删除详情"
      }
    },
    "type": "object",
    "required": ["success", "message", "deleted_count", "failed_count"],
    "title": "ProjectDeleteResponse",
    "description": "删除项目响应"
  },
  "HTTPValidationError": {
    "properties": {
      "detail": {
        "items": {
          "$ref": "#/components/schemas/ValidationError"
        },
        "type": "array",
        "title": "Detail"
      }
    },
    "type": "object",
    "title": "HTTPValidationError"
  },
  "ProjectComponentUpdateRequest": {
    "properties": {
      "current_component": {
        "type": "string",
        "maxLength": 20,
        "title": "Current Component",
        "description": "当前组件"
      }
    },
    "type": "object",
    "required": ["current_component"],
    "title": "ProjectComponentUpdateRequest",
    "description": "项目组件更新请求"
  },
  "ProjectDetailResponse": {
    "properties": {
      "success": {
        "type": "boolean",
        "title": "Success"
      },
      "message": {
        "type": "string",
        "title": "Message"
      },
      "project": {
        "$ref": "#/components/schemas/ProjectResponse"
      }
    },
    "type": "object",
    "required": ["success", "message", "project"],
    "title": "ProjectDetailResponse",
    "description": "项目详情响应"
  },
  "ProjectListResponse": {
    "properties": {
      "success": {
        "type": "boolean",
        "title": "Success"
      },
      "message": {
        "type": "string",
        "title": "Message"
      },
      "projects": {
        "items": {
          "$ref": "#/components/schemas/ProjectResponse"
        },
        "type": "array",
        "title": "Projects"
      },
      "total_count": {
        "type": "integer",
        "title": "Total Count"
      },
      "page": {
        "type": "integer",
        "title": "Page"
      },
      "page_size": {
        "type": "integer",
        "title": "Page Size"
      },
      "total_pages": {
        "type": "integer",
        "title": "Total Pages"
      }
    },
    "type": "object",
    "required": [
      "success",
      "message",
      "projects",
      "total_count",
      "page",
      "page_size",
      "total_pages"
    ],
    "title": "ProjectListResponse",
    "description": "项目列表响应"
  },
  "ProjectDeleteRequest": {
    "properties": {
      "project_ids": {
        "items": {
          "type": "integer"
        },
        "type": "array",
        "maxItems": 100,
        "minItems": 1,
        "title": "Project Ids",
        "description": "要删除的项目ID列表，最多100个"
      }
    },
    "type": "object",
    "required": ["project_ids"],
    "title": "ProjectDeleteRequest",
    "description": "删除项目请求"
  }
}
