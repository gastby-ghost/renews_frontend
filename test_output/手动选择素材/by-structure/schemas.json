{
  "ManualSelectionResponse": {
    "properties": {
      "success": {
        "type": "boolean",
        "title": "Success",
        "description": "操作是否成功"
      },
      "message": {
        "type": "string",
        "title": "Message",
        "description": "响应消息"
      },
      "material_collections": {
        "items": {
          "$ref": "#/components/schemas/SourceMaterialCollection"
        },
        "type": "array",
        "title": "Material Collections",
        "description": "分来源的素材集合",
        "default": []
      },
      "filter_applied": {
        "$ref": "#/components/schemas/ManualSelectionFilter",
        "description": "应用的筛选条件"
      },
      "total_materials": {
        "type": "integer",
        "title": "Total Materials",
        "description": "总素材数量"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time",
        "title": "Timestamp",
        "description": "时间戳"
      }
    },
    "type": "object",
    "required": ["success", "message", "filter_applied", "total_materials"],
    "title": "ManualSelectionResponse",
    "description": "手动选择响应模型"
  },
  "HTTPValidationError": {
    "properties": {
      "detail": {
        "items": {
          "$ref": "#/components/schemas/ValidationError"
        },
        "type": "array",
        "title": "Detail"
      }
    },
    "type": "object",
    "title": "HTTPValidationError"
  },
  "MaterialSelectionResponse": {
    "properties": {
      "success": {
        "type": "boolean",
        "title": "Success",
        "description": "操作是否成功"
      },
      "message": {
        "type": "string",
        "title": "Message",
        "description": "响应消息"
      },
      "added_materials": {
        "items": {
          "$ref": "#/components/schemas/TitleMaterial"
        },
        "type": "array",
        "title": "Added Materials",
        "description": "添加的素材列表",
        "default": []
      },
      "failed_materials": {
        "items": {
          "type": "string"
        },
        "type": "array",
        "title": "Failed Materials",
        "description": "添加失败的素材ID",
        "default": []
      },
      "total_added": {
        "type": "integer",
        "title": "Total Added",
        "description": "成功添加的数量"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time",
        "title": "Timestamp",
        "description": "时间戳"
      }
    },
    "type": "object",
    "required": ["success", "message", "total_added"],
    "title": "MaterialSelectionResponse",
    "description": "素材选择响应模型"
  },
  "ManualSelectionRequest": {
    "properties": {
      "filter_conditions": {
        "$ref": "#/components/schemas/ManualSelectionFilter",
        "description": "筛选条件"
      },
      "user_id": {
        "type": "string",
        "title": "User Id",
        "description": "用户ID"
      }
    },
    "type": "object",
    "required": ["filter_conditions", "user_id"],
    "title": "ManualSelectionRequest",
    "description": "手动选择请求模型"
  },
  "MaterialSelectionRequest": {
    "properties": {
      "project_id": {
        "type": "string",
        "title": "Project Id",
        "description": "项目ID"
      },
      "selected_material_ids": {
        "items": {
          "type": "string"
        },
        "type": "array",
        "title": "Selected Material Ids",
        "description": "选中的素材ID列表"
      },
      "user_id": {
        "type": "string",
        "title": "User Id",
        "description": "用户ID"
      }
    },
    "type": "object",
    "required": ["project_id", "selected_material_ids", "user_id"],
    "title": "MaterialSelectionRequest",
    "description": "素材选择请求模型"
  }
}
