    "required": ["project_id", "reset_type"],
    "title": "ComponentSettingsResetRequest"
  },
  "ComponentSettings": {
    "properties": {
      "user_id": {
        "type": "string",
        "title": "User Id",
        "description": "用户ID"
      },
      "project_id": {
        "type": "string",
        "title": "Project Id",
        "description": "项目ID"
      },
      "component_order": {
        "items": {
          "type": "string"
        },
        "type": "array",
        "title": "Component Order",
        "description": "组件顺序列表"
      },
      "component_visibility": {
        "items": {
          "$ref": "#/components/schemas/ComponentVisibility"
        },
        "type": "array",
        "title": "Component Visibility",
        "description": "组件可见性设置"
      },
      "custom_layout": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "title": "Custom Layout",
        "description": "自定义布局配置"
      },
      "created_at": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Created At",
        "description": "创建时间"
      },
      "updated_at": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Updated At",
        "description": "更新时间"
      }
    },
    "type": "object",
    "required": ["user_id", "project_id", "component_order", "component_visibility"],
    "title": "ComponentSettings"
