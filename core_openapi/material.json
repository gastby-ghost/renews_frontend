{
  "openapi": "3.1.0",
  "info": {
    "title": "写作助手核心服务 - 素材模块",
    "description": "提供写作助手的核心功能API",
    "version": "1.0.0"
  },
  "paths": {
    "POST/api/v1/core/materials/batch": {
      "post": {
        "tags": ["素材", "素材管理"],
        "summary": "Create Materials From List",
        "description": "从完整素材列表批量创建素材\n\n业务规则：\n1. 支持一次创建多个素材\n2. 自动关联到当前用户\n3. 支持标签关联\n\n异常处理：\n- 素材列表为空 → 提示\"素材列表不能为空\"\n- 创建失败 → 提示\"创建素材失败\"",
        "operationId": "create_materials_from_list_api_v1_core_materials_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AddCompleteMaterialRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MaterialListResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        },
        "security": [{ "HTTPBearer": [] }]
      }
    },
    "POST/api/v1/core/materials": {
      "post": {
        "tags": ["素材", "素材管理"],
        "summary": "Create Material",
        "description": "创建单个素材",
        "operationId": "create_material_api_v1_core_materials_post",
        "security": [{ "HTTPBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/MaterialCreate" } }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MaterialResponse" } }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "GET/api/v1/core/materials": {
      "get": {
        "tags": ["素材", "素材管理"],
        "summary": "Get User Materials",
        "description": "获取用户的所有素材",
        "operationId": "get_user_materials_api_v1_core_materials_get",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1, "title": "Page" }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20, "title": "Page Size" }
          },
          {
            "name": "keywords",
            "in": "query",
            "required": false,
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Keywords" }
          },
          {
            "name": "library_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "integer" }, { "type": "null" }],
              "title": "Library Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }],
                "title": "Tags"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MaterialListResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "DELETE/api/v1/core/materials": {
      "delete": {
        "tags": ["素材", "素材管理"],
        "summary": "Delete Materials",
        "description": "批量删除素材\n\n支持两种方式：\n1. 请求体：{\"material_ids\": [1, 2, 3]}\n2. 查询参数：?material_ids=1,2,3",
        "operationId": "delete_materials_api_v1_core_materials_delete",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "material_ids",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "description": "要删除的素材ID列表，逗号分隔，如：1,2,3",
              "title": "Material Ids"
            },
            "description": "要删除的素材ID列表，逗号分隔，如：1,2,3"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  { "$ref": "#/components/schemas/MaterialDeleteRequest" },
                  { "type": "null" }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MaterialDeleteResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "GET/api/v1/core/materials/{material_id}": {
      "get": {
        "tags": ["素材", "素材管理"],
        "summary": "Get Material",
        "description": "获取素材详情",
        "operationId": "get_material_api_v1_core_materials__material_id__get",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "material_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "素材ID，必须为正整数",
              "title": "Material Id"
            },
            "description": "素材ID，必须为正整数"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MaterialResponse" } }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "PUT/api/v1/core/materials/{material_id}": {
      "put": {
        "tags": ["素材", "素材管理"],
        "summary": "Update Material",
        "description": "更新素材",
        "operationId": "update_material_api_v1_core_materials__material_id__put",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "material_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "title": "Material Id" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MaterialUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MaterialResponse" } }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "POST/api/v1/core/projects/{project_id}/materials": {
      "post": {
        "tags": ["素材", "素材管理"],
        "summary": "Add Materials To Project",
        "description": "将素材添加到项目\n\n业务规则：\n1. 验证素材存在性和用户权限\n2. 避免重复绑定\n3. 支持批量操作",
        "operationId": "add_materials_to_project_api_v1_core_projects__project_id__materials_post",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "title": "Project Id" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AddExternalMaterialRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MaterialAddToProjectResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "GET/api/v1/core/projects/{project_id}/materials": {
      "get": {
        "tags": ["素材", "素材管理"],
        "summary": "Get Project Materials",
        "description": "获取项目关联的素材",
        "operationId": "get_project_materials_api_v1_core_projects__project_id__materials_get",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "项目ID，必须为正整数",
              "title": "Project Id"
            },
            "description": "项目ID，必须为正整数"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1, "title": "Page" }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20, "title": "Page Size" }
          },
          {
            "name": "keywords",
            "in": "query",
            "required": false,
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Keywords" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }],
                "title": "Tags"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MaterialListResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "GET/api/v1/core/tags": {
      "get": {
        "tags": ["素材", "素材管理"],
        "summary": "Get User Tags",
        "description": "获取用户的所有标签",
        "operationId": "get_user_tags_api_v1_core_tags_get",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "integer" }, { "type": "null" }],
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "integer" }, { "type": "null" }],
              "default": 50,
              "title": "Page Size"
            }
          },
          {
            "name": "search_keyword",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Search Keyword"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TagListResponse" } }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "POST/api/v1/core/tags": {
      "post": {
        "tags": ["素材", "素材管理"],
        "summary": "Create Tag",
        "description": "创建标签",
        "operationId": "create_tag_api_v1_core_tags_post",
        "security": [{ "HTTPBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/MaterialTagCreate" } }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MaterialTagResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    }
  },
  "components": { "schemas": {} }
}
