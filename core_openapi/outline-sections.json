    "POST/api/v1/core/outlines/{outline_id}/sections": {
      "post": {
        "tags": ["大纲章节", "大纲章节管理"],
        "summary": "Create Section",
        "description": "创建章节\n\n业务规则：\n1. 大纲必须存在且属于当前用户\n2. 章节顺序不能重复\n3. 自动更新大纲的章节计数\n\n异常处理：\n- 大纲不存在 → 404错误\n- 章节顺序重复 → 400错误\n- 创建失败 → 提示\"创建章节失败\"",
        "operationId": "create_section_api_v1_core_outlines__outline_id__sections_post",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "outline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "大纲ID",
              "title": "Outline Id"
            },
            "description": "大纲ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OutlineSectionCreate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OutlineSectionCreateResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
