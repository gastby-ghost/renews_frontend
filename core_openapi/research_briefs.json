{
  "openapi": "3.1.0",
  "info": {
    "title": "写作助手核心服务 - 研究简报模块",
    "description": "提供写作助手的核心功能API",
    "version": "1.0.0"
  },
  "paths": {
    "POST/api/v1/core/projects/{project_id}/briefs": {
      "post": {
        "tags": ["研究简报", "AI简报管理"],
        "summary": "Create Research Brief",
        "description": "为项目创建AI简报\n\n业务规则：\n1. 项目必须存在且属于当前用户\n2. 简报内容不能为空\n\n异常处理：\n- 项目不存在 → 404错误\n- 创建失败 → 提示\"创建简报失败\"",
        "operationId": "create_research_brief_api_v1_core_projects__project_id__briefs_post",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "项目ID",
              "title": "Project Id"
            },
            "description": "项目ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ResearchBriefCreate" } }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResearchBriefCreateResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "GET/api/v1/core/projects/{project_id}/briefs": {
      "get": {
        "tags": ["研究简报", "AI简报管理"],
        "summary": "Get Project Briefs",
        "description": "获取项目的所有AI简报\n\n按创建时间倒序排列",
        "operationId": "get_project_briefs_api_v1_core_projects__project_id__briefs_get",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "项目ID",
              "title": "Project Id"
            },
            "description": "项目ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResearchBriefListResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "GET/api/v1/core/briefs/{brief_id}": {
      "get": {
        "tags": ["研究简报", "AI简报管理"],
        "summary": "Get Brief Detail",
        "description": "获取AI简报详情\n\n异常处理：\n- 简报不存在 → 404错误",
        "operationId": "get_brief_detail_api_v1_core_briefs__brief_id__get",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "brief_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "简报ID",
              "title": "Brief Id"
            },
            "description": "简报ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResearchBriefDetailResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "PUT/api/v1/core/briefs/{brief_id}": {
      "put": {
        "tags": ["研究简报", "AI简报管理"],
        "summary": "Update Research Brief",
        "description": "更新AI简报信息\n\n业务规则：\n1. 简报内容不能为空\n2. 字数必须>=0\n\n异常处理：\n- 简报不存在 → 404错误\n- 更新失败 → 提示\"更新简报失败\"",
        "operationId": "update_research_brief_api_v1_core_briefs__brief_id__put",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "brief_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "简报ID",
              "title": "Brief Id"
            },
            "description": "简报ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ResearchBriefUpdate" } }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResearchBriefUpdateResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "DELETE/api/v1/core/briefs/{brief_id}": {
      "delete": {
        "tags": ["研究简报", "AI简报管理"],
        "summary": "Delete Research Brief",
        "description": "删除AI简报\n\n异常处理：\n- 简报不存在 → 404错误\n- 删除失败 → 提示\"删除简报失败\"",
        "operationId": "delete_research_brief_api_v1_core_briefs__brief_id__delete",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "brief_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "简报ID",
              "title": "Brief Id"
            },
            "description": "简报ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResearchBriefDeleteResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    }
  },
  "components": { "schemas": {} }
}
