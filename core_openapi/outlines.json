{
  "openapi": "3.1.0",
  "info": {
    "title": "写作助手核心服务 - 大纲模块",
    "description": "提供写作助手的核心功能API",
    "version": "1.0.0"
  },
  "paths": {
    "POST/api/v1/core/projects/{project_id}/outlines": {
      "post": {
        "tags": ["大纲", "大纲管理"],
        "summary": "Create Outline",
        "description": "为项目创建大纲\n\n业务规则：\n1. 项目必须存在且属于当前用户\n2. 标题必须存在且为活动状态\n3. 自动停用旧版本，激活新版本\n\n异常处理：\n- 项目不存在 → 404错误\n- 标题不存在 → 400错误\n- 创建失败 → 提示\"创建大纲失败\"",
        "operationId": "create_outline_api_v1_core_projects__project_id__outlines_post",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "项目ID",
              "title": "Project Id"
            },
            "description": "项目ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/OutlineCreate" } }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OutlineCreateResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "GET/api/v1/core/projects/{project_id}/outlines/active": {
      "get": {
        "tags": ["大纲", "大纲管理"],
        "summary": "Get Active Outline",
        "description": "获取项目活动大纲\n\n异常处理：\n- 项目不存在 → 404错误\n- 活动大纲不存在 → 404错误",
        "operationId": "get_active_outline_api_v1_core_projects__project_id__outlines_active_get",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "项目ID",
              "title": "Project Id"
            },
            "description": "项目ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OutlineDetailResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "GET/api/v1/core/projects/{project_id}/outlines/history": {
      "get": {
        "tags": ["大纲", "大纲管理"],
        "summary": "Get Outline History",
        "description": "获取大纲版本历史\n\n异常处理：\n- 项目不存在 → 404错误\n- 查询失败 → 提示\"获取大纲历史失败\"",
        "operationId": "get_outline_history_api_v1_core_projects__project_id__outlines_history_get",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "项目ID",
              "title": "Project Id"
            },
            "description": "项目ID"
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "跳过数量",
              "default": 0,
              "title": "Skip"
            },
            "description": "跳过数量"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "返回数量",
              "default": 100,
              "title": "Limit"
            },
            "description": "返回数量"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OutlineHistoryResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "GET/api/v1/core/outlines/{outline_id}": {
      "get": {
        "tags": ["大纲", "大纲管理"],
        "summary": "Get Outline With Sections",
        "description": "获取大纲及所有章节\n\n异常处理：\n- 大纲不存在 → 404错误\n- 无权限访问 → 403错误",
        "operationId": "get_outline_with_sections_api_v1_core_outlines__outline_id__get",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "outline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "大纲ID",
              "title": "Outline Id"
            },
            "description": "大纲ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OutlineWithSectionsResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "PUT/api/v1/core/outlines/{outline_id}": {
      "put": {
        "tags": ["大纲", "大纲管理"],
        "summary": "Update Outline",
        "description": "更新大纲\n\n异常处理：\n- 大纲不存在 → 404错误\n- 无权限访问 → 403错误\n- 更新失败 → 提示\"更新大纲失败\"",
        "operationId": "update_outline_api_v1_core_outlines__outline_id__put",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "outline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "大纲ID",
              "title": "Outline Id"
            },
            "description": "大纲ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/OutlineUpdate" } }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OutlineUpdateResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "DELETE/api/v1/core/outlines/{outline_id}": {
      "delete": {
        "tags": ["大纲", "大纲管理"],
        "summary": "Delete Outline",
        "description": "删除大纲（仅限非活动版本）\n\n业务规则：\n1. 不能删除活动版本\n2. 不能删除有正文依赖的大纲\n\n异常处理：\n- 大纲不存在 → 404错误\n- 无权限访问 → 403错误\n- 删除失败 → 提示\"删除大纲失败\"",
        "operationId": "delete_outline_api_v1_core_outlines__outline_id__delete",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "outline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "大纲ID",
              "title": "Outline Id"
            },
            "description": "大纲ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OutlineDeactivateResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "PUT/api/v1/core/outlines/{outline_id}/activate": {
      "put": {
        "tags": ["大纲", "大纲管理"],
        "summary": "Activate Outline",
        "description": "激活大纲版本\n\n业务规则：\n1. 自动停用其他版本\n2. 激活当前版本\n\n异常处理：\n- 大纲不存在 → 404错误\n- 无权限访问 → 403错误\n- 激活失败 → 提示\"激活大纲失败\"",
        "operationId": "activate_outline_api_v1_core_outlines__outline_id__activate_put",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "outline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "大纲ID",
              "title": "Outline Id"
            },
            "description": "大纲ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OutlineActivateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OutlineActivateResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "PUT/api/v1/core/outlines/{outline_id}/deactivate": {
      "put": {
        "tags": ["大纲", "大纲管理"],
        "summary": "Deactivate Outline",
        "description": "停用大纲版本\n\n异常处理：\n- 大纲不存在 → 404错误\n- 无权限访问 → 403错误\n- 停用失败 → 提示\"停用大纲失败\"",
        "operationId": "deactivate_outline_api_v1_core_outlines__outline_id__deactivate_put",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "outline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "大纲ID",
              "title": "Outline Id"
            },
            "description": "大纲ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OutlineDeactivateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OutlineDeactivateResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    }
  },
  "components": { "schemas": {} }
}
